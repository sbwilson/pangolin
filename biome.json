{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!_bmad",
      "!_bmad-output",
      "!docs",
      "!.claude",
      "!.agents",
      "!.pi",
      "!skills-lock.json",
      "!**/dist",
      "!**/dev-dist",
      "!**/playwright-report",
      "!**/test-results",
      "!packages/db/migrations/meta"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["temporal-polyfill", "temporal-polyfill/**"],
                "message": "Import Temporal and PlainDate from @pangolin/shared/temporal (AD-14)."
              },
              {
                "group": ["ulid", "ulid/**"],
                "message": "Mint IDs with newId from @pangolin/app (AD-5); only packages/app/src/ids.ts imports ulid."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/shared/src/temporal/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["ulid", "ulid/**"],
                    "message": "Mint IDs with newId from @pangolin/app (AD-5); only packages/app/src/ids.ts imports ulid."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app/src/ids.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["temporal-polyfill", "temporal-polyfill/**"],
                    "message": "Import Temporal and PlainDate from @pangolin/shared/temporal (AD-14)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
