{
  "name": "@pangolin/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adapter: SQLite schema, migrations and repositories",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:strict": "node src/cli/check-strict.ts",
    "check:upgrade": "node src/cli/check-upgrade.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@pangolin/app": "workspace:*",
    "@pangolin/shared": "workspace:*",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "zod": "4.6.5"
  }
}
