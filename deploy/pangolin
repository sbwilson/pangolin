#!/bin/sh
# pangolin: the Pangolin Money admin CLI on the host, installed to /usr/local/bin by install.sh.
# It runs the CLI inside the container: over the admin socket when the stack runs, otherwise in a
# one-off container of the same image (where `reset-user` takes the data-directory lock itself,
# and `status` reports that the server is not running). `restore` stops the stack, runs in a
# one-off container under that lock, and starts the stack again whatever the outcome.
#
# Usage: sudo pangolin status
#        sudo pangolin upgrade <tag>   (PANGOLIN_UPGRADE_TIMEOUT=<seconds> waits longer than 60s for healthy; polled every 3s, so the wait rounds up to a multiple of 3)
#        sudo pangolin backup
#        sudo pangolin restore [--restore-credentials|--keep-credentials] [snapshot|latest]
#        sudo pangolin reset-user <email|person-id>
#        sudo pangolin confirm-bundle
#        sudo pangolin --help
set -eu

# Where install.sh put compose.yaml and .env; overridable for tests.
HOME_DIR=${PANGOLIN_HOME:-/opt/pangolin}

die() {
  printf 'pangolin: %s\n' "$*" >&2
  exit 1
}

[ -f "$HOME_DIR/compose.yaml" ] || die "no $HOME_DIR/compose.yaml: is Pangolin Money installed (install.sh)?"
# The settings are root's (0600); Docker Compose must read them.
[ -r "$HOME_DIR/.env" ] || die "cannot read $HOME_DIR/.env: run as root, e.g. sudo pangolin $*"
command -v docker >/dev/null 2>&1 || die "docker is not installed"

compose() {
  docker compose --project-directory "$HOME_DIR" -f "$HOME_DIR/compose.yaml" "$@"
}


if [ "${1:-}" = upgrade ]; then
  if [ $# -ne 2 ]; then
    printf 'pangolin: usage: pangolin upgrade <tag>\n' >&2
    exit 2
  fi
  TAG=$2

  # How long to wait for the new stack to turn healthy before rolling back: seconds, a positive
  # integer (default 60). Checked before anything is stopped.
  UPGRADE_TIMEOUT=${PANGOLIN_UPGRADE_TIMEOUT:-60}
  case "$UPGRADE_TIMEOUT" in
    '' | *[!0-9]* | 0 | 0[0-9]*)
      die "PANGOLIN_UPGRADE_TIMEOUT must be a positive whole number of seconds, not '$UPGRADE_TIMEOUT'"
      ;;
  esac

  id=$(compose ps -q --status running pangolin 2>/dev/null || true)
  if [ -z "$id" ]; then
    die "refusing to upgrade: stack is not running"
  fi
  status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id" 2>/dev/null || echo missing)
  if [ "$status" != "healthy" ]; then
    die "refusing to upgrade: stack is currently $status, not healthy"
  fi

  CURRENT_IMAGE=$(docker inspect --format '{{.Config.Image}}' "$id")
  # The repository without its tag or digest; a registry port (localhost:5000/x:v1) is not a tag.
  REPO=${CURRENT_IMAGE%%@*}
  case "${REPO##*/}" in *:*) REPO=${REPO%:*} ;; esac
  # A locally built image (install.sh --build: pangolin:local) has no registry to pull from:
  # upgrade from the release repository instead (PANGOLIN_UPGRADE_REPOSITORY overrides it).
  case "$REPO" in
    */*) ;;
    *) REPO=${PANGOLIN_UPGRADE_REPOSITORY:-ghcr.io/sbwilson/pangolin} ;;
  esac
  TARGET_IMAGE="${REPO}:${TAG}"

  # Resolve the tag to a digest first, then verify and run exactly that digest.
  printf 'Pulling %s...\n' "$TARGET_IMAGE"
  docker pull -q "$TARGET_IMAGE" >/dev/null || die "failed to pull $TARGET_IMAGE"
  DIGEST=$(docker inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$TARGET_IMAGE" | grep "^${REPO}@" | head -n1 | cut -d@ -f2)
  [ -n "$DIGEST" ] || die "could not resolve a digest for $TARGET_IMAGE"
  TARGET_REF="${REPO}@${DIGEST}"

  printf 'Verifying %s...\n' "$TARGET_REF"
  DOCKER_CONFIG_MOUNT=
  [ -f "$HOME/.docker/config.json" ] && DOCKER_CONFIG_MOUNT="$HOME/.docker/config.json:/root/.docker/config.json:ro"
  # --network host: a registry on localhost (the CI upgrade test) must be reachable from cosign.
  # shellcheck disable=SC2086
  VERIFY_OUT=$(docker run --rm --network host \
    -v "$HOME_DIR/cosign.pub:/cosign.pub:ro" \
    ${DOCKER_CONFIG_MOUNT:+-v $DOCKER_CONFIG_MOUNT} \
    ghcr.io/sigstore/cosign/cosign:v3.1.3 verify --key /cosign.pub --insecure-ignore-tlog=true \
    "$TARGET_REF" 2>&1) || die "bad signature: $VERIFY_OUT"

  if [ "$CURRENT_IMAGE" = "$TARGET_REF" ]; then
    printf 'already on %s\n' "$TAG"
    exit 0
  fi

  mkdir -p "$HOME_DIR/staging"
  docker run --rm --user 0 -v "$HOME_DIR/staging:/staging" "$TARGET_REF" sh -c 'cp /app/deploy/compose.yaml /app/deploy/pangolin /staging/' || die "failed to extract files"

  # Capture the data volume name before stopping (compose ps returns empty after stop)
  # .Source is the host path for a bind mount (production) and for a named volume alike.
  DATA_VOL=$(docker inspect --format '{{ range .Mounts }}{{ if eq .Destination "/data" }}{{ .Source }}{{ end }}{{ end }}' "$id" 2>/dev/null || true)
  [ -n "$DATA_VOL" ] || die "could not determine the data directory"

  # Backup files left by an earlier upgrade must never be restored over this install, but they
  # may be the only good copy after a crash mid-upgrade: set them aside as .bak.stale (one
  # generation, dropped by the next successful upgrade) instead of deleting them.
  for f in .env compose.yaml pangolin; do
    rm -f "$HOME_DIR/$f.bak.stale"
    [ -f "$HOME_DIR/$f.bak" ] && mv "$HOME_DIR/$f.bak" "$HOME_DIR/$f.bak.stale"
  done

  # Whatever goes wrong from here on, the previous stack must come back up: restore the files
  # the upgrade replaced (if it got that far) and start it again. Cleared once the rollback
  # below takes over, and on success.
  STOPPED=1
  restart_previous() {
    rc=$?
    if [ "$STOPPED" = 1 ] && [ "$rc" -ne 0 ]; then
      printf 'pangolin: upgrade interrupted; restarting the previous stack\n' >&2
      rm -f "$HOME_DIR/.env.new"
      [ -f "$HOME_DIR/.env.bak" ] && mv "$HOME_DIR/.env.bak" "$HOME_DIR/.env"
      [ -f "$HOME_DIR/compose.yaml.bak" ] && mv "$HOME_DIR/compose.yaml.bak" "$HOME_DIR/compose.yaml"
      [ -f "$HOME_DIR/pangolin.bak" ] && mv "$HOME_DIR/pangolin.bak" /usr/local/bin/pangolin
      compose up -d pangolin >/dev/null 2>&1 || true
    fi
  }
  trap restart_previous EXIT
  printf 'Stopping stack for upgrade...\n'
  compose stop pangolin > /dev/null || die "could not stop stack"

  STAMP=$(date +%Y%m%d%H%M%S)
  BACKUP_DIR="$HOME_DIR/pre-upgrade-$STAMP"
  # No -p: an existing directory (two upgrades in one second) is never reused or removed.
  (umask 077 && mkdir "$BACKUP_DIR") && chmod 700 "$BACKUP_DIR" || die "could not create $BACKUP_DIR"
  # Copy DB files from the volume into a host-side directory (stack is stopped). A failed or empty
  # copy aborts here, before anything is replaced: the exit trap restarts the previous stack.
  docker run --rm -v "${DATA_VOL}":/data:ro -v "$BACKUP_DIR":/backup \
    --user 0 --entrypoint sh "$CURRENT_IMAGE" -c 'cp -a /data/pangolin.sqlite* /backup/' \
    || { rm -rf "$BACKUP_DIR"; die "could not copy the database; upgrade aborted, nothing was changed"; }
  [ -s "$BACKUP_DIR/pangolin.sqlite" ] \
    || { rm -rf "$BACKUP_DIR"; die "the database copy is empty; upgrade aborted, nothing was changed"; }
  # Every file copied must hash the same as its source (the stack is stopped, so it is stable).
  docker run --rm -v "${DATA_VOL}":/data:ro -v "$BACKUP_DIR":/backup:ro \
    --user 0 --entrypoint sh "$CURRENT_IMAGE" -c 'cd /data && for f in pangolin.sqlite*; do [ "$(sha256sum < "$f")" = "$(sha256sum < "/backup/$f")" ] || exit 1; done' \
    || { rm -rf "$BACKUP_DIR"; die "the database copy does not match the original; upgrade aborted, nothing was changed"; }
  # Prune: keep only the last two pre-upgrade backups
  ls -1dt "$HOME_DIR"/pre-upgrade-* 2>/dev/null | tail -n +3 | xargs -r rm -rf

  cp -p "$HOME_DIR/.env" "$HOME_DIR/.env.bak" && chmod 600 "$HOME_DIR/.env.bak"
  # Not `sed -i` (GNU's only): the new .env is written beside it, into a copy that keeps its mode
  # and owner (0600, root), then moved over it.
  cp -p "$HOME_DIR/.env" "$HOME_DIR/.env.new"
  sed "s|^PANGOLIN_IMAGE=.*|PANGOLIN_IMAGE=$TARGET_REF|" "$HOME_DIR/.env" >"$HOME_DIR/.env.new"
  mv "$HOME_DIR/.env.new" "$HOME_DIR/.env"
  cp "$HOME_DIR/compose.yaml" "$HOME_DIR/compose.yaml.bak"
  cp "$HOME_DIR/staging/compose.yaml" "$HOME_DIR/compose.yaml"
  cp /usr/local/bin/pangolin "$HOME_DIR/pangolin.bak"
  cp "$HOME_DIR/staging/pangolin" /usr/local/bin/pangolin
  chmod +x /usr/local/bin/pangolin

  printf 'Starting upgraded stack...\n'
  compose up -d pangolin >/dev/null || true

  WAITED=0
  UPGRADE_OK=0
  while [ $WAITED -lt "$UPGRADE_TIMEOUT" ]; do
    NEW_ID=$(compose ps -q pangolin 2>/dev/null || true)
    if [ -n "$NEW_ID" ]; then
      NEW_STATUS=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$NEW_ID" 2>/dev/null || echo missing)
      if [ "$NEW_STATUS" = healthy ]; then
        UPGRADE_OK=1
        break
      elif [ "$NEW_STATUS" = unhealthy ] || [ "$NEW_STATUS" = exited ] || [ "$NEW_STATUS" = dead ]; then
        break  # no point waiting further
      fi
    fi
    sleep 3
    WAITED=$((WAITED + 3))
  done

  if [ $UPGRADE_OK -eq 1 ]; then
    STOPPED=0
    rm -f "$HOME_DIR"/.env.bak "$HOME_DIR"/compose.yaml.bak "$HOME_DIR"/pangolin.bak "$HOME_DIR"/*.bak.stale "$HOME_DIR"/.env.bak.stale
    rm -f "$HOME_DIR/.env.new"
    printf 'Upgrade to %s successful. Old image was %s.\n' "$TAG" "$CURRENT_IMAGE"
    exit 0
  else
    printf 'Health check failed, rolling back...\n'
    # STOPPED stays 1 until the previous stack is back up: if the restore or a later step fails,
    # the exit trap puts the old files back and restarts it.
    # Warn but proceed: if stop fails the container may already be dead; restore anyway.
    compose stop pangolin > /dev/null 2>&1 || printf 'pangolin: warning: stop failed during rollback\n' >&2
    # What the upgraded server wrote during the health wait goes aside first, never deleted:
    # a 0700 rolled-back-<stamp>/ beside the pre-upgrade copy. If it cannot be kept, the live
    # database stays as it is and the exit trap restarts the previous stack.
    ROLLED_DIR="$HOME_DIR/rolled-back-$STAMP"
    (umask 077 && mkdir "$ROLLED_DIR") && chmod 700 "$ROLLED_DIR" || die "could not create $ROLLED_DIR, so the rollback stopped before restoring: the live database was not touched. The previous stack is started again on it (the database the upgraded server used); the pre-upgrade copy is in $BACKUP_DIR"
    docker run --rm -v "${DATA_VOL}":/data:ro -v "$ROLLED_DIR":/backup \
      --user 0 --entrypoint sh "$CURRENT_IMAGE" -c 'for f in /data/pangolin.sqlite*; do [ -e "$f" ] || continue; cp -a "$f" /backup/ || exit 1; done' \
      || { rm -rf "$ROLLED_DIR"; die "could not keep the upgraded database aside, so the rollback stopped before restoring: the live database was not touched. The previous stack is started again on it (the database the upgraded server used); the pre-upgrade copy is in $BACKUP_DIR"; }
    # Keep only the last two rolled-back copies, as with the pre-upgrade ones.
    ls -1dt "$HOME_DIR"/rolled-back-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
    # DATA_VOL was captured before the upgrade started; reuse it for restore
    docker run --rm -v "${DATA_VOL}":/data -v "$BACKUP_DIR":/backup:ro \
      --user 0 --entrypoint sh "$CURRENT_IMAGE" -c '[ -s /backup/pangolin.sqlite ] && rm -f /data/pangolin.sqlite* && cp -a /backup/pangolin.sqlite* /data/' \
      || die "could not restore the DB copy (kept in $BACKUP_DIR)"
    mv "$HOME_DIR/.env.bak" "$HOME_DIR/.env"
    mv "$HOME_DIR/compose.yaml.bak" "$HOME_DIR/compose.yaml"
    mv "$HOME_DIR/pangolin.bak" /usr/local/bin/pangolin
    # Write the marker into the data volume so the server sees it at next start
    docker run --rm -v "${DATA_VOL}":/data --user 0 --entrypoint sh "$CURRENT_IMAGE" -c 'printf "{}" > /data/upgrade-failed.json'
    compose up -d pangolin > /dev/null || die "could not start previous stack after rollback"
    STOPPED=0
    die "upgrade failed during health check. rolled back. The database the upgraded server used (with anything written during the health check) is kept in $ROLLED_DIR"
  fi
fi

# restore: stop → one-off run (which verifies, asks about credentials, swaps and cancels jobs under
# the lock) → start. The stack comes back up even when a check fails, on the database it had.
if [ "${1:-}" = restore ]; then
  # Check the arguments before stopping anything: at most one of --restore-credentials and
  # --keep-credentials, and at most `latest` or a hex snapshot ID.
  shift
  CRED_FLAGS=0
  REFS=0
  BAD=0
  for arg in "$@"; do
    case "$arg" in
      --restore-credentials | --keep-credentials) CRED_FLAGS=$((CRED_FLAGS + 1)) ;;
      -*) BAD=1 ;;
      *)
        REFS=$((REFS + 1))
        printf '%s\n' "$arg" | grep -Eqx 'latest|[0-9a-f]{4,64}' || BAD=1
        ;;
    esac
  done
  if [ $BAD -ne 0 ] || [ $REFS -gt 1 ] || [ $CRED_FLAGS -gt 1 ]; then
    printf '%s\n' "pangolin: usage: pangolin restore [--restore-credentials|--keep-credentials] [latest|<snapshot ID>]" >&2
    exit 2
  fi
  # Without a flag the CLI asks about the credentials, which needs a terminal: refuse now, before
  # stopping anything. With a flag there is no question, so no terminal is needed (-T).
  if [ $CRED_FLAGS -eq 0 ]; then
    if [ ! -t 0 ]; then
      printf '%s\n' "pangolin: restore asks whether to restore the snapshot's credentials or keep the current ones, and there is no terminal to ask on: pass --restore-credentials or --keep-credentials" >&2
      exit 2
    fi
    TTY_FLAG=""
  else
    TTY_FLAG="-T"
  fi
  # Interrupted (Ctrl-C, SIGTERM) during the one-off run: start the stack again all the same.
  trap 'trap - INT TERM; compose up -d pangolin; exit 130' INT
  trap 'trap - INT TERM; compose up -d pangolin; exit 143' TERM
  compose stop pangolin || die "could not stop the stack"
  set +e
  # shellcheck disable=SC2086
  compose run --rm --no-deps $TTY_FLAG pangolin node dist/cli.js restore "$@"
  code=$?
  set -e
  trap - INT TERM
  compose up -d pangolin || die "the restore exited $code, but the stack did not start again"
  exit "$code"
fi

# A failing `ps` (daemon down, a bad .env) must not be taken for a stopped stack.
running=$(compose ps -q --status running pangolin) ||
  die "docker compose ps failed (is Docker running, and is $HOME_DIR/.env valid?)"
if [ -n "$running" ]; then
  exec docker compose --project-directory "$HOME_DIR" -f "$HOME_DIR/compose.yaml" \
    exec -T pangolin node dist/cli.js "$@"
fi
exec docker compose --project-directory "$HOME_DIR" -f "$HOME_DIR/compose.yaml" \
  run --rm --no-deps -T pangolin node dist/cli.js "$@"
