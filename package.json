{
  "name": "pangolin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "[ ! -f scripts/install-git-hooks.sh ] || sh scripts/install-git-hooks.sh",
    "lint": "biome check . && node scripts/check-boundaries.ts",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "check:strict": "pnpm --filter @pangolin/db check:strict",
    "check:upgrade": "pnpm --filter @pangolin/db check:upgrade",
    "build": "pnpm --filter @pangolin/web build && pnpm --filter @pangolin/server build",
    "seed": "node tools/seed/src/cli.ts",
    "mock:llm": "node tools/mock-llm/src/cli.ts",
    "mock:prices": "node tools/mock-prices/src/cli.ts",
    "e2e": "pnpm --filter @pangolin/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@pangolin/db": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
